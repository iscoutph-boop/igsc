GOOGLE_APPS_SCRIPT_WEB_APP_URL=
CRM_SHARED_SECRET=

# Google Apps Script is the single authority for booking lifecycle side effects:
# CRM writes, Google Calendar updates, customer emails, and internal admin emails.
# Keep GOOGLE_APPS_SCRIPT_WEB_APP_URL environment-scoped (Deploy Preview for staging,
# Production only after explicit production approval).
# CRM_SHARED_SECRET is server-only. Never expose it through VITE_ variables, browser code,
# repository files, logs, or responses. The Netlify value must exactly match the Google
# Apps Script Script Property named CRM_SHARED_SECRET. Rotate both sides together.
