{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "igsabroso-site",
  "main": "@tanstack/react-start/server-entry",
  "compatibility_date": "2026-11-22",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
